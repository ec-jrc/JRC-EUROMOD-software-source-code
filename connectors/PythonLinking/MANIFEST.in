# The wheel gets schemas/ and mappings/ from [tool.setuptools.package-data]; the
# sdist needs them named here too, along with the tests, so a source release can
# be checked out and run.
include LICENSE.txt
include README.md
include CHANGELOG.md
recursive-include src/euromod_linking/schemas *.json
recursive-include src/euromod_linking/mappings *.yaml
recursive-include tests *.py

# No `prune docs` / `prune build`: this file is an allowlist, and the sdist's
# default set never reaches outside src/, so both pruned nothing while warning
# on every build. Warnings nobody can act on are how real ones get ignored.
global-exclude __pycache__ *.py[cod] .DS_Store
